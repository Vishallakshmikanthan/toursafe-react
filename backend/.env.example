# ==============================================================================
# TourSafe Backend — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the backend root directory (`backend/.env`).
# 2. Update values according to your target deployment environment (development / staging / production).
# 3. NEVER commit your actual `.env` file containing sensitive production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
APP_NAME="TourSafe Backend"
APP_VERSION=1.0.0
BUILD_SHA=local-dev
ENVIRONMENT=development                # Options: development, staging, production
HOST=0.0.0.0
PORT=8000
DEBUG=True                             # MUST be False in production (enforced at startup)
LOG_LEVEL=INFO                         # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ------------------------------------------------------------------------------
# 2. Database (MongoDB 7.0+)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=toursafe
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_TIMEOUT_MS=5000
MONGODB_TLS=False                      # Set to True for TLS/Atlas in production

# ------------------------------------------------------------------------------
# 3. Cache & Pub/Sub (Redis 7.2+)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=0.5

# ------------------------------------------------------------------------------
# 4. JWT Authentication & Security
# ------------------------------------------------------------------------------
# CRITICAL: In production, JWT_SECRET must be at least 32 cryptographically random characters.
# Generate one with: `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET=toursafe-default-secret-key-32bytes-min-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=toursafe-auth-service
JWT_AUDIENCE=toursafe-client-applications

# ------------------------------------------------------------------------------
# 5. CORS & Gateway Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed client origins.
# Wildcard '*' is strictly prohibited in production mode.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:3000
WS_PING_INTERVAL_SECONDS=30
WS_MAX_PAYLOAD_BYTES=65536
MAX_REQUEST_BODY_BYTES=52428800        # 50MB for KYC documents & photo attachments

# ------------------------------------------------------------------------------
# 6. Real-Time Telemetry Pipeline
# ------------------------------------------------------------------------------
TELEMETRY_RETENTION_DAYS=30            # In accordance with DPDP Act 2023 retention policies
TELEMETRY_WINDOW_DURATION_SEC=3.0      # 3.0-second sliding inference window
TELEMETRY_WINDOW_STRIDE_SEC=1.0        # 1.0-second window stride (50Hz = 150 samples)
TELEMETRY_NOMINAL_FREQUENCY_HZ=50.0    # Expected IMU sampling frequency
TELEMETRY_MIN_COMPLETENESS_RATIO=0.6   # Reject windows with >40% missing packets
TELEMETRY_MAX_TIME_GAP_MS=250.0        # Max allowable timestamp gap in sequence
TELEMETRY_MAX_QUEUE_DEPTH=5000
TELEMETRY_REDIS_TTL_SECONDS=120

# ------------------------------------------------------------------------------
# 7. Machine Learning Engine (LSTM Autoencoder)
# ------------------------------------------------------------------------------
ML_MODEL_VERSION=v1.0.0
ML_ARTIFACTS_DIR=app/ml/artifacts
ML_WINDOW_SAMPLES=150                  # 3 seconds * 50 Hz
ML_FEATURE_COUNT=8                     # [ax, ay, az, gx, gy, gz, linear_accel_mag, gyro_mag]

# ------------------------------------------------------------------------------
# 8. Authority AI Copilot (LLM & RAG Decision Support)
# ------------------------------------------------------------------------------
COPILOT_LLM_PROVIDER=gemini            # Options: gemini, openai, bedrock
COPILOT_MODEL=gemini-2.0-flash
COPILOT_TEMPERATURE=0.1
COPILOT_MAX_TOKENS=2048
COPILOT_TIMEOUT_SECONDS=30.0
COPILOT_MAX_TOOL_CALLS_PER_TURN=8
COPILOT_ACTION_TOKEN_TTL_SECONDS=300

# API Keys (Provide according to selected provider):
GEMINI_API_KEY=
OPENAI_API_KEY=
BEDROCK_REGION=us-east-1

# ------------------------------------------------------------------------------
# 9. Object Storage & Evidence Vault
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local                 # Options: local, s3, gcs
STORAGE_BUCKET_KYC=toursafe-kyc-vault-private
STORAGE_BUCKET_BACKUPS=toursafe-backups-dr
STORAGE_KMS_KEY_ID=