# ==============================================================================
# TourSafe Universal Frontend (Expo SDK 52 / React Native)
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the frontend directory (`frontend/.env`).
# 2. In Expo, any variable exposed to the client bundle MUST be prefixed with `EXPO_PUBLIC_`.
# 3. Sensitive backend secrets (such as JWT secret, DB passwords) must NEVER be placed here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API & WebSocket Connectivity
# ------------------------------------------------------------------------------
# For local browser development:
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws

# For testing on a physical mobile device via Expo Go or Dev Client:
# Replace localhost with your computer's local network IP (e.g., http://192.168.1.100:8000)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8000/ws

# ------------------------------------------------------------------------------
# 2. Development & Demonstration Mode Toggles
# ------------------------------------------------------------------------------
# When true, the application bypasses the auth lock screen for rapid UI review
EXPO_PUBLIC_DEV_BYPASS=false

# When true, uses static high-fidelity mock data (zones, tourists, alerts, responders)
# without requiring an active backend or database connection.
# Set to false to interact directly with the FastAPI backend.
EXPO_PUBLIC_USE_MOCK=false

# ------------------------------------------------------------------------------
# 3. Optional Cloud / Third-Party Services
# ------------------------------------------------------------------------------
# Optional Supabase integration (if using Supabase Auth or Storage)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mapbox / Tile Server API Token (if using custom Mapbox styles; Leaflet fallback is default)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
